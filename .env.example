# Copy to .env and uncomment the block for your mode. See docs/deployment.md § Docker.
# Keep unused lines commented: an empty RAPLA_DBDATASOURCES_RAPLADB_URL= stops Rapla at startup.
# Windows: separate COMPOSE_FILE entries with ';' or set COMPOSE_PATH_SEPARATOR=:

# --- File store (default): nothing to set ---

# --- Embedded HSQLDB in the rapla-data volume ---
# RAPLA_DBDATASOURCES_RAPLADB_URL=jdbc:hsqldb:file:/opt/rapla/data/rapladb
# RAPLA_DBDATASOURCES_RAPLADB_USERNAME=SA

# --- Seed a new database from a data.xml (database modes only) ---
# COMPOSE_FILE=compose.yaml:docker/compose.seed.yaml
# RAPLA_SEED_XML=./seed/data.xml

# --- MariaDB (put mariadb-java-client-*.jar into ./lib) ---
# COMPOSE_FILE=compose.yaml:docker/compose.mariadb.yaml
# RAPLA_DB_PASSWORD=
# RAPLA_LIB_DIR=./lib
