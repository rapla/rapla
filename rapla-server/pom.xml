<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.rapla</groupId>
        <artifactId>rapla-bom</artifactId>
        <version>2.1-SNAPSHOT</version>
        <relativePath>../rapla-bom/pom.xml</relativePath>
    </parent>
    <artifactId>rapla-server</artifactId>
    <name>rapla - server</name>
    <description>Spring Boot server module: REST controllers, JDBC storage, Spring autoconfig, plugin server-side. Depends on rapla-core.</description>
    <dependencies>
        <dependency>
            <groupId>org.rapla</groupId>
            <artifactId>rapla-core</artifactId>
        </dependency>
        <!-- PRD 005 OQ4: iCal4j is server-only. Version pinned in rapla-bom dependencyManagement. -->
        <dependency>
            <groupId>org.mnode.ical4j</groupId>
            <artifactId>ical4j</artifactId>
        </dependency>
        <!-- Spring Boot autoconfig + REST controllers + security -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
        </dependency>
        <!-- Jackson 3 (transitively from spring-boot-starter-web; declared explicit per PRD 005 cleanup E1
             since MailapiClient / HTTPWithJsonMailConnector / TableConfigTest use Jackson directly). -->
        <dependency>
            <groupId>tools.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <groupId>tools.jackson.core</groupId>
            <artifactId>jackson-core</artifactId>
        </dependency>
        <!-- Direct Spring imports outside the starter shapes (declared explicit per PRD 005 cleanup E1) -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-beans</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-oauth2-resource-server</artifactId>
        </dependency>
        <!-- Servlet API -->
        <dependency>
            <groupId>jakarta.servlet</groupId>
            <artifactId>jakarta.servlet-api</artifactId>
            <scope>provided</scope>
        </dependency>
        <!-- HTTP client (used by EWSConnector after RESTeasy removal) -->
        <dependency>
            <groupId>org.apache.httpcomponents</groupId>
            <artifactId>httpclient</artifactId>
        </dependency>
        <!-- Mail -->
        <dependency>
            <groupId>jakarta.mail</groupId>
            <artifactId>jakarta.mail-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.eclipse.angus</groupId>
            <artifactId>angus-mail</artifactId>
        </dependency>
        <!-- Exchange Web Services -->
        <dependency>
            <groupId>com.microsoft.ews-java-api</groupId>
            <artifactId>ews-java-api</artifactId>
        </dependency>
        <!-- Codec utility -->
        <dependency>
            <groupId>commons-codec</groupId>
            <artifactId>commons-codec</artifactId>
        </dependency>
        <!-- @NotNull / @Nullable annotations -->
        <dependency>
            <groupId>com.intellij</groupId>
            <artifactId>annotations</artifactId>
            <scope>provided</scope>
        </dependency>
        <!-- Spring Boot 4 split DataSource autoconfig out of spring-boot-autoconfigure into
             spring-boot-jdbc; needed for RaplaServerProperties' Map<String, DataSourceProperties>
             config-property binding. The class moved package: org.springframework.boot.autoconfigure.jdbc
             → org.springframework.boot.jdbc.autoconfigure. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-jdbc</artifactId>
        </dependency>
        <!-- JDBC drivers. HSQLDB is the embedded, zero-external-server default
             backend (PRD 045) — runtime scope so it lands in the rapla-app fat
             JAR's BOOT-INF/lib/. PostgreSQL / MariaDB / MS SQL Server drivers
             are NOT bundled; they ship in an external ./lib/ (PRD 045 §3). -->
        <dependency>
            <groupId>org.hsqldb</groupId>
            <artifactId>hsqldb</artifactId>
            <classifier>jdk8</classifier>
            <scope>runtime</scope>
        </dependency>
        <!-- Connection pool for the rapla.db-datasources.* DataSources (PRD 045
             Phase 3). spring-boot-jdbc (above) does not pull a pool — only the
             starter does — so DataSourceBuilder finds no DataSource type. Hikari
             is Spring Boot's default pool; runtime scope so it bundles. -->
        <dependency>
            <groupId>com.zaxxer</groupId>
            <artifactId>HikariCP</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!-- Tests -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>mysql</groupId>
            <artifactId>mysql-connector-java</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mariadb.jdbc</groupId>
            <artifactId>mariadb-java-client</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
