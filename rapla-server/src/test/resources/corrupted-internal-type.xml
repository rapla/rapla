      </relax:define>

      <relax:define name="resource">
         <relax:element name="dynatt:resource" id="dea7b72a-6fb6-4b9b-9bdf-12474adf2520" created-at="2026-05-28T18:17:10.589Z" last-changed="2026-05-28T18:17:10.589Z">
            <doc:name lang="en">Resource</doc:name>
            <doc:annotations>
               <rapla:annotation key="nameformat">{name}</rapla:annotation>
               <rapla:annotation key="classification-type">resource</rapla:annotation>
