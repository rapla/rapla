   <relax:grammar>
      <relax:define name="rapla_anonymousEvent">
         <relax:element name="dynatt:rapla_anonymousEvent" id="rapla:anonymousEvent" created-at="2026-05-28T18:17:10.588Z" last-changed="2026-05-28T16:17:10.625Z">
            <doc:name lang="cs">neviditeně</doc:name>
            <doc:name lang="de">nicht sichtbar</doc:name>
            <doc:name lang="en">Not visible</doc:name>
            <doc:name lang="es">no visible</doc:name>
            <doc:name lang="fi">Ei näkyvä</doc:name>
            <doc:name lang="fr">Non visible</doc:name>
            <doc:name lang="nl">Onzichtbaar</doc:name>
            <doc:name lang="pl">Uklkryty</doc:name>
            <doc:name lang="pt">Invisível</doc:name>
            <doc:annotations>
               <rapla:annotation key="nameformat">{p-&gt;type(p)}</rapla:annotation>
               <rapla:annotation key="classification-type">reservation</rapla:annotation>
            </doc:annotations>
            <rapla:permission access="read_type"/>
         </relax:element>
      </relax:define>

      <relax:define name="event">
         <relax:element name="dynatt:event" id="d2b2f66f-363b-4081-a4eb-af0defe909b5" created-at="2026-05-28T18:17:10.589Z" last-changed="2026-05-28T18:17:10.589Z">
            <doc:name lang="en">Event</doc:name>
            <doc:annotations>
               <rapla:annotation key="nameformat">{name}</rapla:annotation>
               <rapla:annotation key="classification-type">reservation</rapla:annotation>
            </doc:annotations>
            <relax:optional>
               <relax:element name="name">
                  <doc:name lang="en">eventname</doc:name>
                  <relax:data type="string"/>
               </relax:element>
            </relax:optional>
            <rapla:permission access="read_type"/>
            <rapla:permission group="category[key='read-events-from-others']" access="read"/>
            <rapla:permission group="category[key='create-events']" access="create"/>
         </relax:element>
      </relax:define>

      <relax:define name="person">
         <relax:element name="dynatt:person" id="d96b10a5-b19a-4712-84d0-6917e9a459c0" created-at="2026-05-28T18:17:10.589Z" last-changed="2026-05-28T18:17:10.589Z">
            <doc:name lang="en">Person</doc:name>
            <doc:annotations>
               <rapla:annotation key="nameformat">{surname} {firstname}</rapla:annotation>
               <rapla:annotation key="classification-type">person</rapla:annotation>
            </doc:annotations>
            <relax:optional>
               <relax:element name="surname">
                  <doc:name lang="en">surname</doc:name>
                  <relax:data type="string"/>
               </relax:element>
            </relax:optional>
            <relax:optional>
               <relax:element name="firstname">
                  <doc:name lang="en">First name</doc:name>
                  <relax:data type="string"/>
               </relax:element>
            </relax:optional>
            <relax:optional>
               <relax:element name="email">
                  <doc:name lang="en">Email</doc:name>
                  <relax:data type="string"/>
               </relax:element>
            </relax:optional>
            <rapla:permission access="read_type"/>
            <rapla:permission access="allocate_conflicts"/>
         </relax:element>
      </relax:define>

      <relax:define name="rapla_unresolvedResource">
         <relax:element name="dynatt:rapla_unresolvedResource" id="rapla:unresolvedResource" created-at="2026-05-28T18:17:10.582Z" last-changed="2026-05-28T16:17:10.625Z">
