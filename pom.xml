<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		 xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<groupId>org.rapla</groupId>
	<artifactId>rapla-aggregator</artifactId>
	<version>2.1-SNAPSHOT</version>
	<url>https://github.com/rapla/rapla</url>
	<description>rapla - reactor aggregator (formerly rapla-master)</description>
	<name>rapla - aggregator</name>
	<packaging>pom</packaging>
	<modules>
		<module>rapla-bom</module>
		<module>rapla-core</module>
		<module>rapla-client</module>
		<module>rapla-server</module>
		<module>rapla-app</module>
		<!-- PRD 003 direction change (2026-05-07) deleted the custom/ WAR-overlay parent.
		     Custom deployments (e.g. dhbwrapla) now declare org.rapla:rapla-server as a
		     dependency and pick up the server stack via Spring Boot autoconfig (Phase A). -->
	</modules>

	<profiles>
		<!-- PRD 017 Phase 3 follow-up: full-stack JaCoCo report.
		     mvn -Pcoverage verify
		     produces target/site/jacoco-aggregate/index.html with coverage from
		     ALL modules' jacoco.exec — so a rapla-app @SpringBootTest that
		     exercises rapla-server code shows up against rapla-server here,
		     not just in rapla-app's own per-module report. -->
		<profile>
			<id>coverage</id>
			<dependencies>
				<!-- rapla-app excluded from class-scan: its target/classes
				     contains JNLP webclient/ jars (multi-release shaded Jackson)
				     that crash JaCoCo's bundle analyzer with "Can't add different
				     class with same name". rapla-app's own bytecode is only
				     RaplaSpringBootApplication.java — losing it from the report
				     scan is fine, what matters is that rapla-app's jacoco.exec
				     (the @SpringBootTest trace, which DOES exercise rapla-core /
				     rapla-server code) gets folded in. The merge step below
				     handles that. -->
				<dependency><groupId>${project.groupId}</groupId><artifactId>rapla-core</artifactId><version>${project.version}</version></dependency>
				<dependency><groupId>${project.groupId}</groupId><artifactId>rapla-client</artifactId><version>${project.version}</version></dependency>
				<dependency><groupId>${project.groupId}</groupId><artifactId>rapla-server</artifactId><version>${project.version}</version></dependency>
			</dependencies>
			<build>
				<plugins>
					<plugin>
						<groupId>org.jacoco</groupId>
						<artifactId>jacoco-maven-plugin</artifactId>
						<version>0.8.11</version>
						<executions>
							<!-- Merge rapla-app's jacoco.exec into the aggregator's
							     target/ dir. report-aggregate's default discovery
							     (**/target/jacoco.exec) picks this up alongside the
							     per-module exec files, so @SpringBootTest coverage
							     gets attributed back to rapla-core / rapla-server
							     bytecode in the final report. -->
							<execution>
								<id>aggregate-merge-app</id>
								<phase>verify</phase>
								<goals><goal>merge</goal></goals>
								<configuration>
									<destFile>${project.basedir}/target/jacoco.exec</destFile>
									<fileSets>
										<fileSet>
											<directory>${project.basedir}/rapla-app/target</directory>
											<includes><include>jacoco.exec</include></includes>
										</fileSet>
									</fileSets>
								</configuration>
							</execution>
							<execution>
								<id>aggregate</id>
								<phase>verify</phase>
								<goals><goal>report-aggregate</goal></goals>
							</execution>
						</executions>
					</plugin>
				</plugins>
			</build>
		</profile>
	</profiles>
</project>
