<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.rapla</groupId>
        <artifactId>rapla-bom</artifactId>
        <version>2.1-SNAPSHOT</version>
        <relativePath>../rapla-bom/pom.xml</relativePath>
    </parent>
    <artifactId>rapla-core</artifactId>
    <name>rapla - core</name>
    <description>Shared module: entities, facade, framework, scheduler, storage interfaces, REST DTOs, i18n. NO Spring Boot, NO Swing.</description>

    <build>
        <resources>
            <resource>
                <directory>${basedir}/src/main/resources-filtered</directory>
                <filtering>true</filtering>
            </resource>
            <resource>
                <directory>${basedir}/src/main/resources</directory>
                <filtering>false</filtering>
            </resource>
        </resources>
    </build>

    <dependencies>
        <!-- REST endpoint interfaces (Spring @HttpExchange + @RequestMapping family) -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-web</artifactId>
        </dependency>
        <!-- Used directly (e.g. ClassPathResource lookups in framework code). PRD 005 Phase E.2 cleanup. -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-beans</artifactId>
        </dependency>
        <!-- Jackson 3 (tools.jackson) — entities, REST DTOs, JSON wire format. -->
        <dependency>
            <groupId>tools.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>tools.jackson.core</groupId>
            <artifactId>jackson-core</artifactId>
            <scope>provided</scope>
        </dependency>
        <!-- @JsonProperty / @JsonIgnore etc. — used by REST DTO classes (transitively pulled via Spring Boot
             starter on the server, but rapla-core has no Spring Boot starter so declare it explicit).
             PRD 005 Phase E.2 cleanup. -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-annotations</artifactId>
            <scope>provided</scope>
        </dependency>
        <!-- Utility -->
        <dependency>
            <groupId>com.intellij</groupId>
            <artifactId>annotations</artifactId>
            <scope>provided</scope>
        </dependency>
        <!-- Tests -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- LanguagePropertyFilesGenerator is a test utility that uses ICU for locale data -->
        <dependency>
            <groupId>com.ibm.icu</groupId>
            <artifactId>icu4j</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
