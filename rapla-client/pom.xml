<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.rapla</groupId>
        <artifactId>rapla-bom</artifactId>
        <version>2.1-SNAPSHOT</version>
        <relativePath>../rapla-bom/pom.xml</relativePath>
    </parent>
    <artifactId>rapla-client</artifactId>
    <name>rapla - client</name>
    <description>Swing client module: presenters, view interfaces, Swing renderers, plugin client extensions. Depends only on rapla-core. Uses spring-context (NOT spring-boot-starter-*) — explicit AnnotationConfigApplicationContext, not autoconfig.</description>
    <dependencies>
        <dependency>
            <groupId>org.rapla</groupId>
            <artifactId>rapla-core</artifactId>
        </dependency>
        <!-- rxjava lives only in rapla-client (PRD 008): Observable/Subject + impls and the
             ObservableTest. Server has no rxjava on the classpath; core has no rxjava on the
             classpath; only this module pulls it in. -->
        <dependency>
            <groupId>io.reactivex.rxjava3</groupId>
            <artifactId>rxjava</artifactId>
        </dependency>
        <dependency>
            <groupId>jakarta.inject</groupId>
            <artifactId>jakarta.inject-api</artifactId>
        </dependency>
        <!-- Spring DI for the Swing client (NOT spring-boot-starter-* — see PRD 005 OQ6) -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-context</artifactId>
        </dependency>
        <!-- Spring Web for client-side @HttpExchange REST proxies -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-web</artifactId>
        </dependency>
        <!-- Jackson — JSON wire format. Without this, Spring's RestClient picks up
             Gson (transitively from rapla-core/legacy) and Gson can't reflect
             java.time.LocalDateTime under the JDK module system. -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.datatype</groupId>
            <artifactId>jackson-datatype-jsr310</artifactId>
        </dependency>
        <!-- @NotNull / @Nullable annotations (org.jetbrains.annotations) -->
        <dependency>
            <groupId>com.intellij</groupId>
            <artifactId>annotations</artifactId>
            <scope>provided</scope>
        </dependency>
        <!-- Tests inherit slf4j/logback/junit-vintage from rapla-bom -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Runtime SLF4J + Logback so `mvn -pl rapla-client -am spring-boot:run` (Swing client launch) has a logger. -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
            <scope>runtime</scope>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <configuration>
                    <mainClass>org.rapla.client.spring.SpringRaplaClient</mainClass>
                    <classpathScope>runtime</classpathScope>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
