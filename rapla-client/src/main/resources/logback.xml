<configuration>
  <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
    <target>System.out</target>
    <encoder>
      <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
    </encoder>
  </appender>

  <!-- LevelChangePropagator syncs Logback per-logger levels down to JUL so the
       SLF4JBridgeHandler installed in SpringRaplaClient.main captures DEBUG
       events from JUL callers that JUL would otherwise filter early. -->
  <contextListener class="ch.qos.logback.classic.jul.LevelChangePropagator">
    <resetJUL>true</resetJUL>
  </contextListener>

  <!-- Root at INFO so the JUL bridge doesn't flood the log with AWT/Swing/X11
       chatter. Rapla code is opted into DEBUG below. -->
  <root level="INFO">
    <appender-ref ref="STDOUT" />
  </root>

  <!-- rapla code uses class-named SLF4J loggers (org.rapla.*) plus a handful of
       named subsystem loggers (PRD 053 § "Child logger decision"). -->
  <logger name="org.rapla" level="DEBUG"/>

  <!-- Named subsystem loggers — operators tune these independently. -->
  <!-- <logger name="rapla.webservice" level="DEBUG"/>     -->
  <!-- <logger name="rapla.exchangeupdate" level="INFO"/>  -->
  <!-- <logger name="rapla.ldap" level="INFO"/>            -->
  <!-- <logger name="rapla.ical" level="INFO"/>            -->
  <!-- <logger name="rapla.404" level="WARN"/>             -->

  <!-- Silence JDK AWT/Swing j.u.l chatter that now flows through the SLF4J
       bridge. Without these, root=DEBUG would mean tens of thousands of
       focus / paint / X11 events per minute. -->
  <logger name="sun.awt" level="WARN"/>
  <logger name="java.awt" level="WARN"/>
  <logger name="javax.swing" level="WARN"/>
  <logger name="sun.swing" level="WARN"/>

  <logger name="org.springframework" level="WARN"/>
  <logger name="org.springframework.beans.factory" level="WARN"/>
  <logger name="org.springframework.context" level="WARN"/>
  <logger name="org.springframework.web.client" level="INFO"/>
  <logger name="org.apache.http" level="WARN"/>
  <logger name="net.fortuna.ical4j" level="WARN"/>
</configuration>
