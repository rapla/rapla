# PRD 035 testbed — incremental schema, fed by the rapla facade.
# Real PRD 035 surface (typed-per-DynamicType reservations, group interfaces,
# §12 batch loaders, mutations, etc.) lands per the design in
# docs/prd/035-rapla-mcp-server.md §"2026-05-24 design refinement".
#
# Cut C (this iteration): structural types are declared here; per-DynamicType
# classification types (`<TypeKey>Classification implements Classification`)
# are GENERATED at startup by ClassificationSdlGenerator from the deployment's
# DynamicTypes and merged into this SDL by HotSwappableGraphQlSource. They
# rebuild on DynamicType admin change (UpdateEvent listener). The SPA queries
# only the `Classification` interface — never the typed implementations.

# ISO-8601 OffsetDateTime. From graphql-java-extended-scalars; registered in
# GraphQlScalarConfig. Used for instant-in-time fields (e.g. serverTime).
scalar DateTime

# ISO-8601 LocalDateTime (wall-time, no offset). Custom scalar in
# GraphQlScalarConfig. Used for rapla domain time fields per PRD 014 —
# appointments, periods, etc. are wall-time semantics (a 10:00 lecture
# happens at 10:00 local, not at a particular UTC instant). Also used for
# rapla AttributeType.DATE attribute values (rapla stores DATE as
# LocalDateTime — see AttributeImpl line 414).
scalar LocalDateTime

type Query {
  # Echo, optionally personalized — smoke test.
  hello(name: String = "world"): String!

  # Server-side current time as ISO-8601 OffsetDateTime.
  serverTime: DateTime!

  # rapla version string.
  version: String!

  # Currently-authenticated user, or null if anonymous.
  # Tests the auth-context → facade lookup path.
  me: User

  # All periods (semester definitions) visible to the caller.
  # Tests facade injection + entity → DTO mapping at the resolver layer.
  # Flat list — no pagination yet; small list (~dozens at most per deployment).
  periods: [Period!]!

  # All users visible to the caller. Bucket 1 from PRD 035.
  # §12: anonymous → []. Authenticated → self + everyone the caller
  # canAdminUser. Pagination not yet (v1; users sets are small for typical
  # rapla deployments).
  users(filter: UserFilter): [User!]!

  # User by username, or null if not found / not visible.
  user(username: String!): User

  # Single category by slash-separated key path (e.g. "user-groups/staff",
  # "departments/cs/ai"). Returns null if any segment fails. Resolved from
  # the super-category root.
  category(path: String!): Category

  # Children of a root category. `rootKey` selects which subtree's children
  # to return (looked up under super); when null, returns the super-category's
  # immediate children. Empty list if rootKey doesn't exist.
  categories(rootKey: String): [Category!]!

  # Allocatables (resources + persons) visible to the caller.
  # §12: every entry is canRead-gated; mixed visible/hidden requests are
  # silently narrowed to the visible subset. Filter narrows the visible
  # subset further (never reveals hidden entities).
  allocatables(filter: AllocatableFilter): [Allocatable!]!

  # Allocatable by id, or null if not found / not visible (§12 — existence
  # not leaked).
  allocatable(id: ID!): Allocatable

  # All DynamicTypes (resource / person / reservation classifications).
  # No §12 — DynamicTypes are deployment-global metadata. Used by SPA form
  # widget config (PRD 035 §4 "descriptor query, lazy") and admin / MCP
  # introspection.
  types: [DynamicType!]!

  # DynamicType by key (e.g. "room", "lecturer", "event"). Null if unknown.
  type(key: String!): DynamicType

  # Permission groups visible to the caller (PRD 035 §5c). Internally backed
  # by the user-groups category subtree; surfaced as Group so the API doesn't
  # leak the storage representation. Anonymous → empty list.
  groups: [Group!]!

  # Permission group by id, or null if unknown / anonymous caller.
  group(id: ID!): Group

  # PRD 055 reservation reads.
  # §12: anonymous → empty / null. Authenticated → canRead-filtered.
  # `reservations` requires a mandatory time window (from + to). The window
  # cap is configurable via rapla.graphql.max-query-window-days (default null
  # = no cap). Result size caps at 5000 entries (default 500).
  reservation(id: ID!): Reservation
  reservations(filter: ReservationFilter!): [Reservation!]!

  # PRD 074 — block-rooted read: materializes recurrence blocks across all
  # caller-visible reservations in the window into a FLAT list (one row = one
  # block), sorted ascending by start. Same §12 + window/limit semantics as
  # `reservations`. Basis for the SPA table/calendar views.
  # PRD 074 — `sort` orders the flat block list server-side (locale Collator for
  # NAME, stable reservation-id tiebreaker); `offset` paginates (skip N). The
  # block count kept is bounded to `offset + limit + 1` (the +1 powers `hasMore`
  # without a full count). Use `@view` to also receive `extensions.view.page`
  # `{ offset, limit, returned, hasMore }`. Default sort = START ASC.
  appointmentBlocks(filter: ReservationFilter!, sort: [BlockSort!], offset: Int): [AppointmentBlock!]!

  # PRD 079 — grouped/bucketed analytics over the full matched set, as typed `data`
  # (not extensions). `groupBy` = dimensions (date bucket / §12 allocatable / custom
  # compute `expr`); `aggregate` = metrics (numeric block field × fn). Empty `groupBy`
  # → one global bucket (= a plain total). Server-evaluated, §12-safe, window-bounded
  # + bucket-capped. See PRD 079.
  appointmentBlockStats(
    filter: ReservationFilter!,
    groupBy: [BlockGroupKey!],
    aggregate: [BlockAggregate!]!,
    limit: Int
  ): [BlockStatBucket!]!

  # PRD 080 item 6 — grouped/bucketed analytics over the §12-visible ALLOCATABLE
  # population (resources/persons), NOT over bookings. `groupBy` = dimensions
  # (DynamicType / custom `expr` / the allocatable itself); `aggregate` = metrics
  # (COUNT, or a numeric `expr` over the allocatable, e.g. capacity sum). Filter =
  # the full AllocatableFilter (typeKeyIn / where<Type> / idIn / accessibleBy*).
  # Shares the generic BlockStatBucket result. e.g. "seats per building".
  allocatableStats(
    filter: AllocatableFilter,
    groupBy: [AllocatableGroupKey!],
    aggregate: [AllocatableAggregate!]!,
    limit: Int
  ): [BlockStatBucket!]!

  # PRD 080 item 7 — grouped/bucketed analytics over the §12-visible RESERVATION
  # set in the window (same gating/window/search as `reservations`). `groupBy` =
  # dimensions (DynamicType / custom `expr` / the reservation itself); `aggregate`
  # = metrics (COUNT, or a numeric `expr` over the reservation). Shares the generic
  # BlockStatBucket result. e.g. "events per course type".
  reservationStats(
    filter: ReservationFilter!,
    groupBy: [ReservationGroupKey!],
    aggregate: [ReservationAggregate!]!,
    limit: Int
  ): [BlockStatBucket!]!

  # PRD 064 — conflicts touching this reservation. §12: caller must be able
  # to read BOTH sides of each conflict + the allocatable; unreadable
  # conflicts are silently dropped.
  conflicts(reservationId: ID!): [Conflict!]!
}

"""
A scheduling conflict — two appointments allocating the same Allocatable at
overlapping times. The two-reservation symmetry is preserved on the wire;
consumers showing "the OTHER side" should compare against the reservation
they queried with. (PRD 064)

`id` is derived from the involved reservation/appointment ids and is
session-scoped — treat as opaque, do not persist.
"""
type Conflict {
  id:            ID!
  allocatable:   Allocatable!
  reservation1:  Reservation!
  reservation2:  Reservation!
  appointment1:  Appointment!
  appointment2:  Appointment!
  startDate:     LocalDateTime!
}

"""
PRD 055 — mandatory time window + optional narrowing predicates for
`reservations(filter:)`. Window is mandatory because the un-windowed query
is "scan every reservation in the deployment" — at admin scale that's many
seconds of CPU per call. Default limit 500; hard cap 5000.

PRD 028 power search: `searchText` + `matchKind` (on this filter) +
ranking are documented at PRD 028 §"GraphQL substrate augmentations".
"""
input ReservationFilter {
  "Mandatory lower bound (inclusive)."
  from:              LocalDateTime!
  "Mandatory upper bound (exclusive). Window cap (if any) is set via rapla.graphql.max-query-window-days; default = no cap."
  to:                LocalDateTime!
  "Exact-match on reservation DynamicType key (e.g. \"event\")."
  typeKeyEq:         String
  "Exact-match on owner id."
  ownerEq:           ID
  "Reservations using ANY of the listed allocatable ids."
  allocatableIdsIn:  [ID!]
  """
  PRD 066 — reservations using ANY allocatable matching this
  AllocatableFilter. Lets the SPA pass its tree-selection
  (`typeKeyIn` + per-type `whereXxx` + `idIn`) in one shot instead of
  resolving allocatable ids in a separate roundtrip. UNIONed with
  `allocatableIdsIn` when both are set.
  """
  allocatableMatching: AllocatableFilter
  "Case-insensitive substring match on default-locale name (legacy — prefer `searchText` + `matchKind` for new flows). ANDs with `searchText` if both are set."
  nameContains:      String
  "PRD 028 Phase 1 — match against the rapla-resolved name (same value as `nameContains`); paired with `matchKind` for prefix/substring/fuzzy."
  searchText:        String
  "PRD 028 Phase 1 — algorithm choice for `searchText`. Defaults to SUBSTRING (matches the legacy `nameContains` behavior)."
  matchKind:         MatchKind = SUBSTRING
  """
  PRD 069 — restrict to events the named **user** may access (admin-scoped).
  Username handle, like `user(username:)`. XOR with `accessibleByUserId` /
  `accessibleByGroup`. The caller must be allowed to administer the user
  (`canAdminUser`), else a uniform FORBIDDEN error (no existence leak).
  """
  accessibleByUsername: String
  "PRD 069 — same as `accessibleByUsername` but by opaque user id. XOR with the other access selectors."
  accessibleByUserId:   ID
  """
  PRD 069 — restrict to events any of these **groups** may access (admin-scoped).
  Union over the list. Groups are key paths relative to the `user-groups` root —
  no `user-groups/` prefix (e.g. `"staff"` or nested `"staff/leads"`). Group
  access on events is type-level (the event type grants the group the right).
  Caller must administer every group (`canAdminGroup`), else FORBIDDEN.
  """
  accessibleByGroup:    [String!]
  "PRD 069 — minimum access level the target must hold (default READ = visible; EDIT = editable). Ignores time-window constraints in v1."
  accessLevel:          AccessLevel = READ
  "Cap result size. Default 500, hard cap 5000."
  limit:             Int
}

"""
PRD 028 Phase 1 — string-match algorithm for power search.
Shared between `ReservationFilter.matchKind`, `AllocatableFilter.matchKind`,
and the future top-level `Query.search` (PRD 060). Server-side ranking
respects this ordering: PREFIX > SUBSTRING > FUZZY.
"""
enum MatchKind {
  "Field value must START with the query (case-insensitive). Cheap, narrow."
  PREFIX
  "Field value must CONTAIN the query (case-insensitive). Default."
  SUBSTRING
  "Approximate match — small edit distance from the query. Broad fallback."
  FUZZY
}

"PRD 074 — sort direction for `appointmentBlocks(sort:)`."
enum SortDir { ASC  DESC }

"PRD 074 — sortable fields of the flat block list. NAME = locale-collated block name; DURATION omitted in v1 (formatted string, not numerically comparable)."
enum BlockSortField { START  END  NAME }

"PRD 074 — one sort key for `appointmentBlocks(sort:)`. Multiple keys chain left-to-right; a stable reservation-id tiebreaker is always appended."
input BlockSort {
  field: BlockSortField!
  dir:   SortDir = ASC
}

"""
PRD 069 — permission access level, mirrors `org.rapla.entities.domain.Permission.AccessLevel`.
Used by the `accessLevel` argument of the access-by-target filters
(`accessibleByUsername` / `accessibleByUserId` / `accessibleByGroup`). Levels are
ordered; a filter for level L matches when the target's effective level ≥ L.
The two everyday values: `READ` ("what can they see"), `EDIT` ("what can they edit").
"""
enum AccessLevel {
  DENIED
  READ_TYPE
  CREATE
  READ_NO_ALLOCATION
  READ
  REQUEST
  ALLOCATE
  ALLOCATE_CONFLICTS
  EDIT
  ADMIN
}

"""
PRD 035 Bucket 1 — narrowing predicates for `users(filter:)`. All fields
optional; null = unconstrained. Multiple predicates AND together. Filter
runs over the §12-visible subset, never over the raw user table.
"""
input UserFilter {
  "True → only users with a non-blank authSource (external-IdP). False → only locally-authenticated."
  hasAuthSource:    Boolean
  "Exact-match on authSource (e.g. \"keycloak\", \"microsoft\")."
  authSourceEq:     String
  "True → only admins. False → only non-admins."
  isAdmin:          Boolean
  "Case-insensitive substring match on username."
  usernameContains: String
  """
  PRD 069 — restrict to users that are members of **any** of these groups
  (union), including membership via a sub-group. Groups are **key paths
  relative to the `user-groups` root** — no `user-groups/` prefix, same handle
  as `accessibleByGroup` (e.g. `"MOS"` or nested `"MOS/T/INF"`). This resolves
  the bare-key ambiguity of `User.groups` (a Studiengang key like `"INF"` exists
  at many campuses). Unknown path → INVALID_VALUE. ANDs with the other filters.
  """
  inGroup:          [String!]
}

"""
Narrowing predicates for `allocatables(filter:)`. All fields optional;
null = unconstrained. Multiple predicates AND together. Filter runs over
the §12-visible subset.

For typed per-attribute filtering, see the GENERATED `where<TypeKey>`
fields (PRD 035 §5d). They appear on this input alongside the scalar
fields below — one per resource/person DynamicType in the deployment.
"""
input AllocatableFilter {
  "Exact-match on the DynamicType key (e.g. \"room\", \"lecturer\"). When set, pre-filters at the storage layer (skips full-table scan)."
  typeKeyEq:    String
  """
  Match any DynamicType key in the list (cross-type union). Server-side
  union — e.g. `typeKeyIn: ["Raum", "Teilraum"]` returns rooms AND partial
  rooms in one result list. `typeKeyEq` takes precedence if both are set.
  Each key is validated against {@code types}; unknown keys are ignored.
  """
  typeKeyIn:    [String!]
  "True → only persons. False → only resources. null → both."
  isPersonEq:   Boolean
  "Case-insensitive substring match on displayName (legacy — prefer `searchText` + `matchKind` for new flows). ANDs with `searchText` if both are set."
  nameContains: String
  "PRD 028 Phase 1 — match against `Allocatable.displayName`; paired with `matchKind` for prefix/substring/fuzzy."
  searchText:   String
  "PRD 028 Phase 1 — algorithm choice for `searchText`. Defaults to SUBSTRING (matches the legacy `nameContains` behavior)."
  matchKind:    MatchKind = SUBSTRING
  "Exact-match on owner id."
  ownerEq:      ID
  """
  PRD 066 — additive id-selection that ALWAYS appears in the result
  (subject only to §12 canRead). Ids matching the type-bucket
  (`typeKeyEq` / `typeKeyIn` + `whereXxx`) and ids in `idIn` are
  UNIONed. The per-type filter rules do NOT apply to `idIn` picks —
  the caller has explicitly named them. Empty filter (all fields null)
  still means "everything readable"; `idIn` alone means "exactly these
  ids" (no type-bucket contribution).
  """
  idIn:         [ID!]
  """
  PRD 069 — restrict to resources the named **user** may access (admin-scoped).
  Username handle, like `user(username:)`. XOR with `accessibleByUserId` /
  `accessibleByGroup`. The caller must be allowed to administer the user
  (`canAdminUser`), else a uniform FORBIDDEN error (no existence leak).
  """
  accessibleByUsername: String
  "PRD 069 — same as `accessibleByUsername` but by opaque user id. XOR with the other access selectors."
  accessibleByUserId:   ID
  """
  PRD 069 — restrict to resources any of these **groups** may access
  (admin-scoped). Union over the list. Groups are key paths relative to the
  `user-groups` root — no `user-groups/` prefix (e.g. `"staff"` or nested
  `"staff/leads"`). Caller must administer every group (`canAdminGroup`), else
  FORBIDDEN.
  """
  accessibleByGroup:    [String!]
  "PRD 069 — minimum access level the target must hold (default READ = visible; EDIT = editable). Ignores time-window constraints in v1."
  accessLevel:          AccessLevel = READ
  """
  Cap the result size. Iteration stops as soon as `limit` visible matches
  have accumulated. Strongly recommended on large deployments — at admin
  scale, 11 typed fields × 40k+ rows is ~15s of graphql-java per-field
  overhead. Null = no limit (legacy default; may change).
  """
  limit:        Int
}

# === PRD 035 §5d — Generic Where input types ===
# Predicate inputs reused by every generated <TypeKey>Where input. All
# operators are optional (null = unconstrained); when multiple non-null
# operators are passed inside one *Where they AND together.

"Predicates for STRING-valued attributes."
input StringWhere {
  eq:         String
  ne:         String
  in:         [String!]
  "Case-insensitive substring contains."
  contains:   String
  startsWith: String
  endsWith:   String
  isNull:     Boolean
}

"Predicates for INT-valued attributes (rapla stores as Long)."
input IntWhere {
  eq:     Int
  ne:     Int
  in:     [Int!]
  gt:     Int
  gte:    Int
  lt:     Int
  lte:    Int
  isNull: Boolean
}

"Predicates for BOOLEAN-valued attributes."
input BooleanWhere {
  eq:     Boolean
  isNull: Boolean
}

"Predicates for DATE-valued attributes (rapla stores as LocalDateTime)."
input LocalDateTimeWhere {
  eq:      LocalDateTime
  ne:      LocalDateTime
  gt:      LocalDateTime
  gte:     LocalDateTime
  lt:      LocalDateTime
  lte:     LocalDateTime
  "Inclusive between — [from, to]."
  between: [LocalDateTime!]
  isNull:  Boolean
}

"""
Predicates for CATEGORY-valued attributes targeting ORGANIZATION-kind roots
(hierarchical trees). For VALUE_LIST roots, use the generated `<EnumName>Where`
input instead (typed enum predicates, autocomplete-friendly).
"""
input CategoryWhere {
  eq:           ID
  ne:           ID
  in:           [ID!]
  "Match by slash-separated KEY path (e.g. \"Standort/Karlsruhe\")."
  path:         String
  "Match any descendant of the given category id — useful for ORGANIZATION trees."
  descendantOf: ID
  isNull:       Boolean
}

"""
Predicates for multi-select CATEGORY (list) attributes targeting
ORGANIZATION-kind roots. For VALUE_LIST multi-select, use the generated
`<EnumName>ListWhere` instead.
"""
input CategoryListWhere {
  contains:    ID
  containsAny: [ID!]
  containsAll: [ID!]
  isEmpty:     Boolean
  isNull:      Boolean
}

"""
Predicates for ALLOCATABLE-valued attributes. Currently supports id-equality
predicates. Future extension (deferred PRD): nested sub-where on the referenced
allocatable's own classification.
"""
input AllocatableWhere {
  eq:     ID
  ne:     ID
  in:     [ID!]
  "PRD 074 — match the REFERENCED allocatable by its display name (case-insensitive substring). Lets you filter through a reference in ONE query, e.g. rooms whose building name contains \"MOS\" (Standort Mosbach) via Raum.whereRaum.Gebaeude.nameContains."
  nameContains: String
  isNull: Boolean
}

"""
Predicates for multi-select ALLOCATABLE attributes (rapla `multi-select=true`,
typically `package=true` flavor). Symmetric mirror of CategoryListWhere.
"""
input AllocatableListWhere {
  contains:    ID
  containsAny: [ID!]
  containsAll: [ID!]
  isEmpty:     Boolean
  isNull:      Boolean
}

type User {
  id:         ID!
  username:   String!
  name:       String!
  email:      String
  isAdmin:    Boolean!
  # Identity provider that authenticated this user — e.g. "rapla" (local
  # password), "microsoft", "google", "keycloak". Null for legacy / locally-
  # created users with no recorded source.
  authSource: String
  # Permission groups the user is a member of (PRD 035 §5c). Internally
  # backed by the user-groups category subtree; surfaced as the dedicated
  # Group type so the API doesn't leak the storage representation.
  groups:     [Group!]!
}

"""
Permission group (PRD 035 §5c). Internally rapla stores these as categories
under the user-groups subtree, but the GraphQL API treats them as a first-
class type so the contract stays clean if the storage representation ever
moves. Currently flat; hierarchical fields (parent / children) deferred
to a separate PRD if real consumer demand emerges.
"""
type Group {
  id:   ID!
  key:  String!
  name: String!
}

type Period {
  # rapla Periods have no synthetic id — they're identified by name.
  name:  String!
  start: LocalDateTime!
  end:   LocalDateTime!
}

# rapla Category — a node in the hierarchical metadata tree (value-list roots,
# organization trees, semester groupings, etc.). Returned by the category(path)
# and categories(rootKey) queries; children/parent traversal is lazy.
#
# The `user-groups` subtree is filtered out of every Category resolver — it
# surfaces only via the dedicated `Group` type (see permission group section).
# PRD 035 §5a.
type Category {
  id:       ID!
  key:      String!
  name:     String!         # default-locale resolved
  path:     String!         # slash-separated, relative to the super-category root
  kind:     CategoryKind!   # how the consumer should render this Category
  parent:   Category        # null at the top-level (super-category is hidden)
  children: [Category!]!
}

"""
Render-discrimination for Categories. Determined per category root (deployment-
agnostic): explicit `category-kind` admin annotation > heuristic on tree depth
> default. See PRD 035 §5a for the determination rules.
"""
enum CategoryKind {
  "Flat picklist (root → leaves only). Render as a dropdown / chip selector."
  VALUE_LIST
  "Hierarchical tree (depth ≥ 2). Render as a drill-down / tree picker."
  ORGANIZATION
  "rapla-internal subtrees (super-category root etc.). Not normally exposed; flagged for completeness."
  SYSTEM
}

# === Allocatables + classifications =========================================

"""
Whether an Allocatable represents a bookable resource or a person.
Derived from the DynamicType's classification-type annotation.
"""
enum AllocatableType {
  RESOURCE
  PERSON
}

"""
A bookable entity in rapla — room, equipment, lecturer, student, etc.
The `type` is structural (resource vs person); the `classification` carries
deployment-specific attribute values typed via the DynamicType schema.
The classification field is narrowed to `AllocatableClassification` so an
inline fragment on an event-only type (e.g. `... on LehrveranstaltungClassification`)
fails GraphQL validation rather than silently returning null at runtime.
"""
type Allocatable {
  id:             ID!
  type:           AllocatableType!
  "PRD 080 — true when this allocatable is a person (== type PERSON). Universal across instances."
  isPerson:       Boolean!
  "PRD 080 — true when the allocatable's DynamicType is annotated location=true (room/venue marker, same as iCal export). Deployment-configured; the annotation key is universal — no instance-specific type key needed."
  isLocation:     Boolean!
  "PRD 074 — the allocatable's name composition (nameformat), locale-resolved. variant selects DISPLAY/EXPORT/PLANNING (EXPORT/PLANNING fall back to DISPLAY when the type lacks them)."
  name(variant: NameVariant = DISPLAY): String
  "Deprecated alias for name(variant: DISPLAY). Locale-resolved, classification-derived."
  displayName:    String! @deprecated(reason: "use name(variant: DISPLAY)")
  owner:          User
  createdAt:      DateTime
  lastModifiedAt: DateTime
  classification: AllocatableClassification!
}

# === DynamicType + descriptors (PRD 035 §4) =================================

"""
What kind of entity a DynamicType classifies. rapla has three categories of
DynamicTypes — resources, persons, and reservations.
"""
enum ClassificationType {
  RESOURCE
  PERSON
  RESERVATION
}

"""
The Java type used to represent an attribute value. Drives widget choice in
the SPA per PRD 035 §5 (valueType + annotations + constraints → widget).
"""
enum AttributeValueType {
  STRING
  INT
  BOOLEAN
  DATE
  CATEGORY
  ALLOCATABLE
}

"""
Cardinality of an attribute's value. CATEGORY and ALLOCATABLE attributes
may be multi-select; STRING / INT / BOOLEAN / DATE are always SINGLE in
the current rapla data model.
"""
enum Multiplicity {
  SINGLE
  LIST
  BELONGS_TO
  PACKAGE
}

"""
A deployment-defined classification (event type, resource type, person type).
The shape of values an `Allocatable` or `Reservation` of this type carries.

Per-attribute structure (name, valueType, constraints) is exposed via
**introspection of the generated `<TypeKey>Classification` type** + custom
directives — NOT via a parallel `attributes: [AttributeDescriptor!]!`
surface (β refactor 2026-05-28, PRD 055 decision log). The schema-as-data
path is the single source of truth.
"""
type DynamicType {
  id:                 ID!
  key:                String!
  "Locale-resolved name (e.g. \"Lecture room\")."
  name:               String!
  classificationType: ClassificationType!
}

# === Classification — interface + AttributeValue =============================

"""
Classification — an Allocatable's or Reservation's typed attribute payload.
Implementations are GENERATED at startup, one per DynamicType
(`<TypeKey>Classification`), exposing typed per-attribute fields for codegen
consumers (plugins, MCP).
SPA consumers query the interface only (PRD 035 §540 lock-in) — one
deployment-agnostic renderer iterates `attributes` and uses the descriptor
on `type` for widget config.

Three-way interface split:
- `Classification` — the structural base. Every generated type implements it.
  Rapla-internal types (classification-type=rapla — Period, Template, etc.)
  implement ONLY this; they're invisible from entity-level narrowing.
- `AllocatableClassification` — narrows the target type of `Allocatable.classification`.
  Implemented by generated types whose DynamicType has
  classification-type ∈ {resource, person}.
- `ReservationClassification` — narrows the target type of `Reservation.classification`
  (lands with the reservation resolvers next batch). Implemented by generated
  types whose DynamicType has classification-type = reservation.
"""
interface Classification {
  "Human-readable key of the DynamicType (e.g. \"event\", \"room\", \"Lehrveranstaltung\"). Unique across the deployment. Matches the @oneOf variant name on the input side, the codegen typed-narrow fragment selector, and the @expectedType directive on ALLOCATABLE attribute fields. For the underlying DynamicType's UUID (rare — admin renames don't require it; rapla keys are uniqueness-enforced), use `type { id }`."
  typeKey: String!
  type:    DynamicType!
}

"""
Resource / person classifications. The `Allocatable.classification` field
targets this interface so a typed-narrow fragment like
`... on LehrveranstaltungClassification` (an event type) fails GraphQL
validation up-front instead of resolving to null at runtime.
"""
interface AllocatableClassification implements Classification {
  typeKey: String!
  type:    DynamicType!
}

"""
Reservation classifications. Targets `Reservation.classification` when
the reservation resolvers land next batch. Same split rationale as
`AllocatableClassification`.
"""
interface ReservationClassification implements Classification {
  typeKey: String!
  type:    DynamicType!
}

# === Custom directives on generated classification fields (PRD 055 β refactor) ===
# These replace the AttributeDescriptor + AttributeValue parallel surface.
# The schema's typed field types ARE the descriptor; directives carry the
# bits introspection doesn't natively expose (display names, expected
# allocatable target type, category root, multiplicity flavor).

"""
The locale-resolved human-readable name for a generated classification
field. Default-locale string baked at SDL generation time.
"""
directive @displayName(value: String!) on FIELD_DEFINITION

# === PRD 074 — view render-meta directives (query-side; consumed by the SPA renderer, PRD 078) ===
# Presence of @view on the operation makes the server emit `extensions.view`
# (resolved title + column descriptors) alongside `data`. Field directives feed
# that descriptor; they do NOT change `data`.
"PRD 074 — marks an operation as a renderable view; triggers extensions.view (key/title/columns)."
directive @view(title: String) on QUERY
"PRD 074 — column presentation override: explicit header and/or order."
directive @column(header: String, order: Int) on FIELD
"PRD 074 — column fetched but not displayed (e.g. a group/sort key)."
directive @hidden on FIELD
"PRD 074 — list-cell join separator (default \", \")."
directive @join(separator: String) on FIELD
"PRD 074 — project a single leaf out of a nested object/list column so the GUI renders a flat value. `field` names the leaf; omitted = the column's single selected sub-field. Meta-only (data stays nested)."
directive @flatten(field: String) on FIELD
"PRD 079 — aggregation function for appointmentBlockStats."
enum AggregateFn { SUM  COUNT  MEAN  MIN  MAX }

"PRD 079 — date bucket granularity. ISO_WEEK is ISO-8601 week-based (Mon-start)."
enum TimeBucket { DAY  ISO_WEEK  MONTH  YEAR }

"PRD 079 — which block date a time-bucket dimension reads."
enum BlockDateField { START  END }

"PRD 079 — numeric metric source. DURATION_MINUTES = wall-clock (end−start); DURATION_UNIT = eventtimecalculator (break-adjusted, ÷timeUnit → UE/hours, formatted text)."
enum BlockMetricField { DURATION_MINUTES  DURATION_UNIT }

"""
PRD 079 — one grouping dimension. Supply EXACTLY ONE of:
- `date` (+ optional `by`) → time bucket of that block date,
- `allocatables` → §12-readable allocatables (block fans out to each; e.g. rooms),
- `expr` → a custom compute expression (same engine as `AppointmentBlock.compute`; the
  string result is the bucket key — group by anything you can express).
`key` names the dimension in the result bucket's `keys`.
"""
input BlockGroupKey {
  key: String!
  date: BlockDateField
  by: TimeBucket
  allocatables: AllocatableFilter
  expr: String
  "PRD 080 — group by the block's reservation (the event); the StatKey carries the Reservation as `entity`. \"hours/sessions per Veranstaltung\"."
  reservation: Boolean
}

"""
PRD 079 — one metric aggregated by `fn`, named `key` in the bucket's `values`. Supply EXACTLY ONE of:
- `field` (typed numeric source: DURATION_MINUTES / DURATION_UNIT), or
- `expr` (PRD 074 Stufe b — a numeric rapla expression, same engine as `compute`; the result is
  coerced to a number, canonical '.' decimal). Non-numeric/formatted results are skipped.
In-expression arithmetic (add/sub/mul/div) needs the EL number-model (PRD 073) — deferred.
"""
input BlockAggregate {
  key: String!
  field: BlockMetricField
  expr: String
  fn: AggregateFn!
}

"""
PRD 080 item 6 — one grouping dimension for `allocatableStats`. Supply EXACTLY ONE of:
- `type: true` → group by the allocatable's DynamicType (value = type name; entity = null),
- `expr` → a custom compute expression over the allocatable (string result = bucket key),
- `self: true` → group by the allocatable itself; StatKey carries the Allocatable as `entity`.
`key` names the dimension in the result bucket's `keys`.
"""
input AllocatableGroupKey {
  key:  String!
  type: Boolean
  expr: String
  self: Boolean
}

"""
PRD 080 item 6 — one metric for `allocatableStats`. `fn: COUNT` counts allocatables in the bucket
(no `expr` needed). For SUM/MEAN/MIN/MAX supply a numeric `expr` over the allocatable (same engine
as `AppointmentBlock.compute`; result coerced to a number — e.g. a capacity attribute).
"""
input AllocatableAggregate {
  key:  String!
  expr: String
  fn:   AggregateFn!
}

"""
PRD 080 item 7 — one grouping dimension for `reservationStats`. Supply EXACTLY ONE of:
- `type: true` → group by the reservation's DynamicType (value = type name; entity = null),
- `expr` → a custom compute expression over the reservation (string result = bucket key),
- `self: true` → group by the reservation itself; StatKey carries the Reservation as `entity`.
`key` names the dimension in the result bucket's `keys`.
"""
input ReservationGroupKey {
  key:  String!
  type: Boolean
  expr: String
  self: Boolean
}

"""
PRD 080 item 7 — one metric for `reservationStats`. `fn: COUNT` counts reservations in the bucket.
For SUM/MEAN/MIN/MAX supply a numeric `expr` over the reservation (same engine as `compute`).
"""
input ReservationAggregate {
  key:  String!
  expr: String
  fn:   AggregateFn!
}

"PRD 079 — one grouped result row: the dimension keys, the aggregate values, and the block count."
type BlockStatBucket {
  keys:   [StatKey!]!
  values: [StatValue!]!
  count:  Int!
}

"PRD 079 — a bucket's dimension value (`key` = the BlockGroupKey.key, `value` = the bucket label)."
type StatKey {
  key:    String!
  value:  String!
  "PRD 080 — the typed group entity for entity dimensions (allocatables/reservation/category-resolving expr); null for time/scalar dimensions. Select its fields directly (e.g. room size)."
  entity: StatEntity
}

"PRD 080 — the meaningful, selectable group entities a StatKey may resolve to."
union StatEntity = Allocatable | Reservation | Category

"PRD 079 — an aggregate result. `number` is the numeric value; `text` is the plugin-formatted form for DURATION_UNIT (UE/hours), else null."
type StatValue { key: String!  number: Float  text: String }

"""
For ALLOCATABLE-typed attributes: which DynamicType the referenced
allocatable must belong to. Renders the SPA's allocatable picker filter.
"""
directive @expectedType(key: String!) on FIELD_DEFINITION

"""
For CATEGORY-typed attributes: slash-separated key path of the allowed
root category. Renders the SPA's category picker root.
"""
directive @rootCategory(path: String!) on FIELD_DEFINITION

"""
The multiplicity flavor on multi-valued attribute fields. SINGLE fields
do not carry this directive (they're emitted without a list wrapper).
LIST is the default for `[X!]` types and may be omitted too. BELONGS_TO
and PACKAGE are explicit markers that drive widget choice in the SPA.
"""
directive @multiplicity(value: Multiplicity!) on FIELD_DEFINITION

"""
Marker on required attribute fields. The field type stays nullable
(existing pre-required-flag data may carry null), but new saves must
populate.
"""
directive @required on FIELD_DEFINITION

# === PRD 055 Reservation read types (minimal — full resolver impl in PRD 055 later) ===
# Added 2026-05-28 alongside PRD 056 mutations so create/update return Reservation.

"PRD 074 — name composition variant selector. EXPORT/PLANNING fall back to DISPLAY when the type lacks that nameformat."
enum NameVariant { DISPLAY  EXPORT  PLANNING }

"""
Calendar event — the central booking entity. One or more Appointments
(time slots) carry the booking against Allocatables (resources/persons).
"""
type Reservation {
  id:             ID!
  """
  PRD 074 — the reservation's name composition, locale-resolved server-side. The `variant`
  selects the nameformat family: DISPLAY (nameformat), EXPORT (nameformat_export), PLANNING
  (nameformat_planning); EXPORT/PLANNING fall back to DISPLAY when the type lacks them.
  """
  name(variant: NameVariant = DISPLAY): String
  "Deprecated alias for name(variant: DISPLAY)."
  displayName:    String @deprecated(reason: "use name(variant: DISPLAY)")
  classification: ReservationClassification!
  appointments:   [Appointment!]!
  allocations:    [Allocation!]!
  owner:          User
  createdAt:      DateTime
  lastModifiedAt: DateTime
  "min(appointment.start)"
  firstDate:      LocalDateTime!
  "max(appointment.maxEnd)"
  lastDate:       LocalDateTime!
  "Server-derived per caller — controls edit-button gating in the SPA without a second roundtrip."
  canModify:      Boolean!
  """
  PRD 028 Phase 1 — true if any visible conflict touches this reservation
  (allows the SPA's power-search badge UX without a second roundtrip).
  Visibility-filtered: conflicts where the caller can't read the other
  side OR the allocatable do not count. The full conflict list lives on
  `Query.conflicts(reservationId:)` (PRD 064).
  """
  hasConflicts:   Boolean!
}

"""
A single appointment of a Reservation. Owns its recurrence rule;
materialized blocks come from `blocks(from:, to:)` on demand.
"""
type Appointment {
  id:        ID!
  "PRD 074 Baustein 9 — appointment-aware name (reservation.formatAppointment). Honors appointment-note overrides; differs from AppointmentBlock.name only in lacking a single occurrence's date context. DISPLAY/EXPORT/PLANNING; EXPORT/PLANNING fall back to DISPLAY when undefined."
  name(variant: NameVariant = DISPLAY): String
  start:     LocalDateTime!
  end:       LocalDateTime!
  allDay:    Boolean!
  "Null = single-occurrence appointment."
  repeating: RepeatingRule
  """
  Pre-resolved per-appointment allocatables (PRD 055 Q4 — restrictions
  applied). Restriction-aware editing reads parent Reservation.allocations.

  PRD 074 A — optional `filter` narrows the (already §12-canRead-gated) list using the
  FULL `AllocatableFilter` (same type + same evaluators as `Query.allocatables`): scalar
  predicates, `where<TypeKey>` attribute filters, `idIn`, `accessibleBy*`/`accessLevel`
  (e.g. "resources of this event I may edit"), `limit`. The canRead gate runs BEFORE the
  filter, so narrowing can never leak a hidden allocatable.
  """
  allocatables(filter: AllocatableFilter): [Allocatable!]!
  "Materialize blocks within a window. Server-side recurrence expansion."
  blocks(from: LocalDateTime!, to: LocalDateTime!): [AppointmentBlock!]!
}

"Materialized occurrence of a recurring Appointment. No id (synthetic per-expansion)."
type AppointmentBlock {
  start:       LocalDateTime!
  end:         LocalDateTime!
  isException: Boolean!
  "PRD 074 Baustein 9 — FLAT block-aware name (block → reservation.formatAppointmentBlock). NOT the reservation name: honors appointment-note overrides (appointmentnote plugin), so a block can name differently than its reservation. DISPLAY/EXPORT/PLANNING variants; EXPORT/PLANNING fall back to DISPLAY when the type defines no such format."
  name(variant: NameVariant = DISPLAY): String
  "PRD 074 — the reservation this block belongs to (block → reservation → displayName)."
  reservation: Reservation
  "PRD 074 A — the block's allocatables, §12-gated, with the FULL AllocatableFilter (scalar + where<TypeKey> + idIn + accessibleBy*/accessLevel + limit; same evaluators as Query.allocatables). Per-appointment restriction applied for this block's appointment."
  allocatables(filter: AllocatableFilter): [Allocatable!]!
  "PRD 074 — server-evaluated event-time-calculator duration (e.g. 2 UE 0 Min), via the rapla function bridge. Null if the eventtimecalculator plugin is absent."
  duration: String
  "PRD 074 — server-evaluated formatted time range of the block (e.g. 10:00 - 11:30)."
  times: String
  "PRD 074 — wall-clock occupancy of this block in whole minutes (end−start, no break adjustment). Numeric → aggregatable via @aggregate / groupable (PRD 079). Hours = /60. For break-adjusted teaching units use the `duration` string."
  durationMinutes: Int
  "PRD 074 — inline composition column: evaluates an arbitrary rapla expression (same language as a nameformat; p = the block) against this block, e.g. {p->concat(substring(times(p),0,5),substring(times(p),8,13))}. Invalid expr returns null. Max 2000 chars."
  compute(expr: String!): String
}

enum RepeatingType { DAILY  WEEKLY  MONTHLY  YEARLY }

type RepeatingRule {
  type:       RepeatingType!
  interval:   Int!
  end:        Date
  count:      Int
  "0-6, WEEKLY-only — needed for 'every Tue + Thu' patterns."
  weekdays:   [Int!]
  exceptions: [Date!]!
}

"""
Per-allocatable restriction record. `appointmentIds: null` = bound to all
appointments (default). Non-null = restricted to those appointment ids
(intra-document references to Appointment.id within the same Reservation).
"""
type Allocation {
  allocatable:    Allocatable!
  appointmentIds: [ID!]
}

scalar Date

# === PRD 056 — mutation surface (locked 2026-05-28) ===
#
# Mutations split into three rings:
#   1. Editor flow — single-entity full-state CRUD
#   2. Bulk transforms — named intent verbs for admin workflows
#   3. applyChanges — generic atomic batch (cross-type compound + concurrency-checked delete)
#
# ATOMIC-only in v1 (PRD 062 defers PARTIAL + heavier robustness patterns).
# `@oneOf` on ChangeOp enforces exactly-one-variant at parse time.

scalar Duration

type Mutation {
  # ===== editor flow =====

  "Create a new reservation. Server sets owner to caller. Client-supplied id (UUID) recommended for retry safety; absent = server generates."
  createReservation(input: CreateReservationInput!): Reservation!

  """
  Update an existing reservation's content (classification / appointments /
  allocations). Owner changes go through `changeReservationOwner`; type
  changes are rejected (future `reshapeReservation` mutation).
  `expectedLastChanged` enables optimistic concurrency — mismatch returns
  `CONCURRENT_MODIFICATION` with the current value in the error extension.
  """
  updateReservation(id: ID!, input: UpdateReservationInput!,
                    expectedLastChanged: LocalDateTime): Reservation!

  # ===== bulk transforms =====

  "Reassign owner across N reservations to a single new owner. Admin/group-admin workflow."
  changeReservationOwner(ids: [ID!]!, newOwnerId: ID!): BulkResult!

  "Shift the start of N reservations' appointments by an ISO-8601 Duration. Recurrence rules preserved structurally."
  moveReservations(ids: [ID!]!, dateShift: Duration!): BulkResult!

  "Duplicate N reservations with new UUIDs, shifted by an ISO-8601 Duration. Copies start with no permission overrides."
  copyReservations(ids: [ID!]!, dateShift: Duration!): BulkResult!

  "Delete N reservations. No per-id concurrency check — accepts the race. For concurrency-checked delete use applyChanges with DeleteInput.expectedLastChanged."
  deleteReservations(ids: [ID!]!): BulkResult!

  # ===== PRD 063 — Allocatable (resource / person) mutations =====

  """
  Create a new Allocatable (resource or person). Owner defaults to the
  caller; admins may override via `input.ownerId`. The classification's
  @oneOf variant must match `input.typeKey`. Same β² typed-input pattern
  as PRD 056 reservations.
  """
  createAllocatable(input: CreateAllocatableInput!): Allocatable!

  """
  Update an existing Allocatable's content (classification only). Type
  changes rejected (future reshape verb); owner immutable here (future
  `changeAllocatableOwner` if real demand). `expectedLastChanged`
  enables optimistic concurrency.
  """
  updateAllocatable(id: ID!, input: UpdateAllocatableInput!,
                    expectedLastChanged: LocalDateTime): Allocatable!

  """
  Delete N Allocatables. No per-id concurrency check. Rejected with
  STORAGE_ERROR if any reservation references the allocatable (rapla's
  storage layer enforces this; admin must delete dependent reservations
  first or reassign).
  """
  deleteAllocatables(ids: [ID!]!): BulkResult!

  # ===== applyChanges (escape hatch) =====

  """
  Generic atomic batch — one UpdateEvent per call. Maps 1:1 to rapla's
  `operator.dispatch`. Used for cross-type compound workflows and the
  concurrency-checked delete path. ChangeOp carries the typed operation
  variants; `@oneOf` enforces exactly-one-set per parse.
  """
  applyChanges(operations: [ChangeOp!]!): BulkResult!

  # ===== PRD 057 — DynamicType (schema editor) mutations =====

  """
  Upsert a DynamicType. `input.id` null = create; supplied = update.
  Admin-only. Update with `expectedLastChanged` mismatch returns
  `CONCURRENT_MODIFICATION`. Returns the stored DynamicType reflecting
  the dispatched state. Note: the generated `<TypeKey>Classification`
  GraphQL type appears in the schema on the next hot-swap poll (~10s);
  callers that want the typed-narrow shape immediately should poll
  `__type(name: ...)` until present.
  """
  saveDynamicType(input: DynamicTypeInput!,
                  expectedLastChanged: LocalDateTime): DynamicType!

  """
  Delete N DynamicTypes by id. Admin-only. Rejected with
  `REFERENCE_EXISTS` (and `referrers: [ID!]` capped at 50) if any data
  instance still uses the type — the admin must first delete instances
  or reassign via a future reshape mutation.
  """
  deleteDynamicTypes(ids: [ID!]!): BulkResult!
}

# === PRD 057 — DynamicType mutation inputs ===

"""
Upsert payload for a DynamicType. `id` null = create; supplied = update.
`attributes` is order-significant — rapla preserves attribute order; the
SPA drag-reorder UI submits the new order and the server stores it.
"""
input DynamicTypeInput {
  "Null = create; supplied = update (must match an existing DynamicType.id)."
  id:                 ID
  "Admin-supplied — unique across deployment. Verbatim emission to SDL per PRD 058 (no silent transforms)."
  key:                String!
  "Multi-locale name (rapla DynamicType is MultiLanguageNamed)."
  name:               MultiLanguageStringInput!
  classificationType: ClassificationType!
  "Order-significant — index = display order."
  attributes:         [AttributeInput!]!
  "Open-ended annotation map (name-format, etc.). v1: known keys only — server rejects unknown keys with INVALID_VALUE."
  annotations:        [KeyValueInput!]
}

"""
Attribute definition within a DynamicType. `id` null for new attributes
(server generates); supplied for updates to existing attributes.
"""
input AttributeInput {
  id:             ID
  key:            String!
  name:           MultiLanguageStringInput!
  valueType:      AttributeValueType!
  multiplicity:   Multiplicity!
  required:       Boolean!
  "CATEGORY only — root of allowed subtree. REFERENCE_NOT_FOUND if unresolved."
  rootCategoryId: ID
  "ALLOCATABLE only — required target DynamicType key (matches @expectedType directive on the read side). REFERENCE_NOT_FOUND if unresolved."
  expectedTypeKey: String
  "Optional default value. @oneOf enforces exactly-one-variant at parse time. Must match the attribute's valueType + multiplicity."
  defaultValue:   DefaultValueInput
  annotations:    [KeyValueInput!]
}

"""
Multi-locale name shape. `default` is the default-locale fallback
(required). `translations` provides per-locale overrides; missing
locales fall back to `default`.
"""
input MultiLanguageStringInput {
  default:      String!
  translations: [LocaleEntryInput!]
}

input LocaleEntryInput {
  "ISO code: \"de\", \"en\", \"fr\"."
  locale: String!
  value:  String!
}

"""
Typed primitive value for AttributeInput.defaultValue. The @oneOf
directive enforces exactly-one-variant per input.
"""
input DefaultValueInput @oneOf {
  stringValue:    String
  intValue:       Int
  boolValue:      Boolean
  dateValue:      LocalDateTime
  categoryId:     ID
  allocatableId:  ID
  stringValues:   [String!]
  categoryIds:    [ID!]
  allocatableIds: [ID!]
}

"""
Open-ended key/value pair for annotation maps. v1: server rejects
unknown keys with INVALID_VALUE.
"""
input KeyValueInput {
  key:   String!
  value: String!
}

# === PRD 056 — generic types ===

"Heterogeneous batch result. `overallStatus` quick-signals success/failure; per-op detail in `results[]` indexed to the input order."
type BulkResult {
  overallStatus: BulkStatus!
  results:       [ChangeResult!]!
}

"PARTIAL_SUCCESS is reserved for the future PARTIAL mode (PRD 062)."
enum BulkStatus { SUCCESS  REJECTED }

"""
One entry per applyChanges operation, indexed to the input array.
Per-operation kind populates exactly one of the typed fields below;
errors[] populates on failure.
"""
type ChangeResult {
  "Position in the request's operations[]."
  index:        Int!
  "Populated for create/update Reservation ops."
  reservation:  Reservation
  "Populated for create/update Allocatable ops (future allocatables-write PRD)."
  allocatable:  Allocatable
  "Populated for create/update User ops (future users-write PRD)."
  user:         User
  "Populated for any delete op."
  deletedKind:  EntityKind
  "Populated for any delete op."
  deletedId:    ID
  "Populated on failure. Empty list = op succeeded."
  errors:       [ValidationError!]!
}

enum EntityKind { RESERVATION  ALLOCATABLE  USER  PERMISSION }

"""
Stable-coded validation error. `code` is a string (not enum) so future codes
don't break existing clients. Common codes: REQUIRED, INVALID_VALUE,
REFERENCE_NOT_FOUND, REFERENCE_EXISTS, PERMISSION_DENIED, CONCURRENT_MODIFICATION,
ID_COLLISION, INVALID_TYPE_CHANGE, CONFLICT. Extensions vary per code.
"""
type ValidationError {
  "GraphQL-style path: operations[3].createReservation.appointments[0].repeating.exceptions[2]"
  path:    String!
  code:    String!
  message: String!
}

# === PRD 056 — ChangeOp + input types ===

"""
A single operation in an applyChanges batch. Exactly one variant must be
set per op (engine-enforced by `@oneOf`). New entity types grow via
additive variants for future allocatables-write / users-write PRDs.
"""
input ChangeOp @oneOf {
  createReservation: CreateReservationInput
  updateReservation: ChangeOpUpdateReservation
  deleteReservation: DeleteInput
  createAllocatable: CreateAllocatableInput
  updateAllocatable: ChangeOpUpdateAllocatable
  deleteAllocatable: DeleteInput
}

"Update variant wrapped with the id since update-by-id can't piggyback on a mutation-level argument inside ChangeOp."
input ChangeOpUpdateReservation {
  id:                  ID!
  input:               UpdateReservationInput!
  expectedLastChanged: LocalDateTime
}

"Concurrency-checked delete payload for applyChanges. The top-level deleteReservations skips expectedLastChanged for bulk simplicity."
input DeleteInput {
  id:                  ID!
  expectedLastChanged: LocalDateTime
}

"""
Create a Reservation. typeKey is the discriminator; the @oneOf variant in
classification must match it. Server sets owner to caller (no ownerId
field — see PRD 056 OQ1.a).
"""
input CreateReservationInput {
  "Client-supplied UUID for retry safety + same-batch refs. Null = server generates."
  id:             ID
  "Discriminator — must match the @oneOf variant in classification (the DynamicType key, e.g. \"event\")."
  typeKey:        String!
  classification: ReservationClassificationInput!
  "Must be non-empty (PRD 056 OQ1.d). Order-significant."
  appointments:   [AppointmentInput!]!
  "Restriction-aware allocations. Empty list valid (reservation with no resources is legal but unusual)."
  allocations:    [AllocationInput!]!
}

"""
Update a Reservation's content. Server validates typeKey matches stored
(PRD 056 OQ1.c — in-place type changes rejected). Owner immutable here
(use changeReservationOwner).
"""
input UpdateReservationInput {
  "Defensive cross-check — must equal the stored reservation's typeKey."
  typeKey:        String!
  classification: ReservationClassificationInput!
  "Non-empty. Order-significant."
  appointments:   [AppointmentInput!]!
  allocations:    [AllocationInput!]!
}

"""
Appointment input — id is nullable for new appointments (server assigns
UUIDs), required for updates to existing appointments. Same-batch
references from AllocationInput.appointmentIds use these ids.
"""
input AppointmentInput {
  id:        ID
  start:     LocalDateTime!
  end:       LocalDateTime!
  allDay:    Boolean!
  "Null = single occurrence."
  repeating: RepeatingRuleInput
}

input RepeatingRuleInput {
  type:       RepeatingType!
  interval:   Int!
  end:        Date
  count:      Int
  "0-6, WEEKLY-only."
  weekdays:   [Int!]
  exceptions: [Date!]!
}

"""
Restriction record. `appointmentIds: null` = bound to all appointments
of the parent reservation. Non-null = restricted to those appointment
ids (must reference appointments declared in the same input).
"""
input AllocationInput {
  "References an existing allocatable, or a same-batch UUID for create."
  allocatableId:  ID!
  appointmentIds: [ID!]
}

# === PRD 063 — Allocatable mutation inputs ===

"""
Create an Allocatable. typeKey is the discriminator; the @oneOf variant
in classification must match it. Owner defaults to the caller; admins
may set `ownerId` to assign a different owner.
"""
input CreateAllocatableInput {
  "Client-supplied UUID for retry safety + same-batch refs. Null = server generates."
  id:             ID
  "Discriminator — must match the @oneOf variant in classification (the DynamicType key, e.g. \"room\")."
  typeKey:        String!
  classification: AllocatableClassificationInput!
  "Optional. Null = caller becomes owner. Admin-only when non-null."
  ownerId:        ID
}

"""
Update an Allocatable's content. Server validates typeKey matches stored
(in-place type changes rejected — analogous to PRD 056 OQ1.c). Owner
immutable here.
"""
input UpdateAllocatableInput {
  "Defensive cross-check — must equal the stored allocatable's typeKey."
  typeKey:        String!
  classification: AllocatableClassificationInput!
}

"Update variant wrapped with the id for applyChanges."
input ChangeOpUpdateAllocatable {
  id:                  ID!
  input:               UpdateAllocatableInput!
  expectedLastChanged: LocalDateTime
}
